#!/bin/bash
set -e

MODEL="$1"

if [ -z "$MODEL" ]; then
    echo "Usage: $0 <model>"
    exit 1
fi

LATENT_MODEL="/data/models/${MODEL}.ts"
UMAP_MODEL="./result/latent_analysis/umaps/umap_${MODEL}.pkl"
BASE_DIR="./result/ldm/${MODEL}"

SHIP_CLASSIFIER="./result/vae_classifiers/trained_models/latent/${MODEL}/ship"
CHANNEL_CLASSIFIER="./result/vae_classifiers/trained_models/latent/${MODEL}/channel"
SHALLOW_CLASSIFIER="./result/vae_classifiers/trained_models/latent/${MODEL}/shallow"

for INPUT_CH in {0..3}; do
    for OUTPUT_CH in {0..3}; do

        if [ "$INPUT_CH" -eq "$OUTPUT_CH" ]; then
            continue
        fi

        OUT_DIR="${BASE_DIR}/models/specialist/${INPUT_CH}-${OUTPUT_CH}"
        ANALYSIS_DIR="${BASE_DIR}/analysis/specialist"

        echo "========================================"
        echo "Training ${INPUT_CH} -> ${OUTPUT_CH}"
        echo "Output: ${OUT_DIR}"
        echo "========================================"

        python app/ldm_train.py \
            --ie-latent-model "$LATENT_MODEL" \
            --output-dir "$OUT_DIR" \
            --fixed-input-channel "$INPUT_CH" \
            --fixed-output-channel "$OUTPUT_CH"

        python app/ldm_visualize.py \
            --ie-latent-model "$LATENT_MODEL" \
            --output-dir "$OUT_DIR" \
            --ldm-checkpoint "$OUT_DIR" \
            --umap-model "$UMAP_MODEL"

        python app/ldm_classify.py \
            --ie-latent-model "$LATENT_MODEL" \
            --output-dir "$ANALYSIS_DIR" \
            --ldm-checkpoint "$OUT_DIR" \
            --ship-model "$SHIP_CLASSIFIER" \
            --channel-model "$CHANNEL_CLASSIFIER" \
            --shallow-model "$SHALLOW_CLASSIFIER"

    done
done

OUT_DIR="${BASE_DIR}/models/generalist"
ANALYSIS_DIR="${BASE_DIR}/analysis/generalist"

python app/ldm_train.py \
    --ie-latent-model "$LATENT_MODEL" \
    --output-dir "$OUT_DIR" \
    --channel-mode variable

python app/ldm_visualize.py \
    --ie-latent-model "$LATENT_MODEL" \
    --output-dir "$OUT_DIR" \
    --ldm-checkpoint "$OUT_DIR" \
    --umap-model "$UMAP_MODEL"

python app/ldm_classify.py \
    --ie-latent-model "$LATENT_MODEL" \
    --output-dir "$ANALYSIS_DIR" \
    --ldm-checkpoint "$OUT_DIR" \
    --ship-model "$SHIP_CLASSIFIER" \
    --channel-model "$CHANNEL_CLASSIFIER" \
    --shallow-model "$SHALLOW_CLASSIFIER"

OUT_DIR="${OUTPUT_DIR}/models/generalist_with_distance"
ANALYSIS_DIR="${BASE_DIR}/analysis/generalist_with_distance"

python app/ldm_train.py \
    --ie-latent-model "$LATENT_MODEL" \
    --output-dir "$OUT_DIR" \
    --channel-mode variable \
    --embed-distance

python app/ldm_visualize.py \
    --ie-latent-model "$LATENT_MODEL" \
    --output-dir "$OUT_DIR" \
    --ldm-checkpoint "$OUT_DIR" \
    --umap-model "$UMAP_MODEL"

python app/ldm_classify.py \
    --ie-latent-model "$LATENT_MODEL" \
    --output-dir "$ANALYSIS_DIR" \
    --ldm-checkpoint "$OUT_DIR" \
    --ship-model "$SHIP_CLASSIFIER" \
    --channel-model "$CHANNEL_CLASSIFIER" \
    --shallow-model "$SHALLOW_CLASSIFIER"
