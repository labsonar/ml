#!/bin/bash
set -e

MODEL="$1"
CNN_INPUT="$2"

if [ -z "$MODEL" ] || [ -z "$CNN_INPUT" ]; then
    echo "Usage: $0 <model> <cnn1d|cnn2d>"
    exit 1
fi

case "$CNN_INPUT" in
    cnn1d|1d|time)
        REPRESENTATION="raw"
        MODEL_DIR="time"
        CNN="cnn1d"
        ;;
    cnn2d|2d|mel|spectral)
        REPRESENTATION="spectral"
        MODEL_DIR="spectral"
        CNN="cnn2d"
        ;;
    *)
        echo "Error: CNN must be 'cnn1d' or 'cnn2d'"
        exit 1
        ;;
esac

VAE_DATASET="/data/iemanja_vae/${MODEL}"
BASE_DIR="./result/vae_classifiers"

echo "========================================"
echo "Model          : ${MODEL}"
echo "CNN            : ${CNN}"
echo "Representation : ${REPRESENTATION}"
echo "Model directory: ${MODEL_DIR}"
echo "========================================"

echo ""
echo "========= Reconstruct dataset ========="

if [ ! -f "${VAE_DATASET}/data/999.wav" ]; then
    python app/iemanja_vae_reconstructor.py --model "/data/models/${MODEL}.ts"
else
    echo "Dataset already reconstructed: ${VAE_DATASET}"
fi


echo ""
echo "========= Train classifiers on original dataset ========="

if [ ! -f "${BASE_DIR}/trained_models/${MODEL_DIR}/ship/original/best.ckpt" ]; then
    echo "Training original ship classifier"

    python app/iemanja_classifier.py \
        --model "${CNN}" \
        --ie-target CLASS \
        --ie-representation "${REPRESENTATION}" \
        --output-dir "${BASE_DIR}/trained_models/${MODEL_DIR}/ship/original" \
        --ie-dataset-dir /data/iemanja_truncated
else
    echo "Original ship classifier already trained"
fi


if [ ! -f "${BASE_DIR}/trained_models/${MODEL_DIR}/channel/original/best.ckpt" ]; then
    echo "Training original channel classifier"

    python app/iemanja_classifier.py \
        --model "${CNN}" \
        --ie-target "NAME_(US)" \
        --ie-representation "${REPRESENTATION}" \
        --output-dir "${BASE_DIR}/trained_models/${MODEL_DIR}/channel/original" \
        --ie-dataset-dir /data/iemanja_truncated
else
    echo "Original channel classifier already trained"
fi


echo ""
echo "========= Train classifiers on reconstructed dataset ========="

if [ ! -f "${BASE_DIR}/trained_models/${MODEL_DIR}/ship/${MODEL}/best.ckpt" ]; then
    echo "Training reconstructed ship classifier: ${MODEL}"

    python app/iemanja_classifier.py \
        --model "${CNN}" \
        --ie-target CLASS \
        --ie-representation "${REPRESENTATION}" \
        --output-dir "${BASE_DIR}/trained_models/${MODEL_DIR}/ship/${MODEL}" \
        --ie-dataset-dir "${VAE_DATASET}"
else
    echo "Reconstructed ship classifier already trained: ${MODEL}"
fi


if [ ! -f "${BASE_DIR}/trained_models/${MODEL_DIR}/channel/${MODEL}/best.ckpt" ]; then
    echo "Training reconstructed channel classifier: ${MODEL}"

    python app/iemanja_classifier.py \
        --model "${CNN}" \
        --ie-target "NAME_(US)" \
        --ie-representation "${REPRESENTATION}" \
        --output-dir "${BASE_DIR}/trained_models/${MODEL_DIR}/channel/${MODEL}" \
        --ie-dataset-dir "${VAE_DATASET}"
else
    echo "Reconstructed channel classifier already trained: ${MODEL}"
fi


echo ""
echo "========= Cross evaluation ========="

python app/iemanja_vae_cross_classifier.py \
    --ie-representation "${REPRESENTATION}" \
    --ie-target CLASS \
    --model1-type "${CNN}" \
    --model1 "${BASE_DIR}/trained_models/${MODEL_DIR}/ship/original" \
    --dataset1-dir /data/iemanja_truncated \
    --model2-type "${CNN}" \
    --model2 "${BASE_DIR}/trained_models/${MODEL_DIR}/ship/${MODEL}" \
    --dataset2-dir "${VAE_DATASET}" \
    --output-dir "${BASE_DIR}/cross_comparison/${MODEL}/${MODEL_DIR}/ship"


python app/iemanja_vae_cross_classifier.py \
    --ie-representation "${REPRESENTATION}" \
    --ie-target "NAME_(US)" \
    --model1-type "${CNN}" \
    --model1 "${BASE_DIR}/trained_models/${MODEL_DIR}/channel/original" \
    --dataset1-dir /data/iemanja_truncated \
    --model2-type "${CNN}" \
    --model2 "${BASE_DIR}/trained_models/${MODEL_DIR}/channel/${MODEL}" \
    --dataset2-dir "${VAE_DATASET}" \
    --output-dir "${BASE_DIR}/cross_comparison/${MODEL}/${MODEL_DIR}/channel"
